# ExifTool only writes tags it has a definition for. This declares jetlag's own XMP
# namespace so every metadata backend can write XMP-jetlag:* properties. Reading them
# needs no config: exiftool reads unknown XMP namespaces from the file itself.

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        jetlag => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::jetlag',
            },
        },
    },
    # An unqualified CreateDate in a QuickTime file prefers XMP, so a stray XMP
    # CreateDate would shadow the movie header. This reads the mvhd atom under a key of its own.
    'Image::ExifTool::Composite' => {
        MovieHeaderCreateDate => {
            Require => { 0 => 'QuickTime:CreateDate' },
            ValueConv => '$val[0]',
            PrintConv => '$prt[0]',
        },
    },
);

%Image::ExifTool::UserDefined::jetlag = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-jetlag', 2 => 'Other' },
    NAMESPACE => { 'jetlag' => 'http://ns.jetlag.app/1.0/' },
    WRITABLE => 'string',
    originalDateTimeOriginal => { },
    originalCreateDate => { },
    originalMediaCreateDate => { },
    originalTrackCreateDate => { },
    originalCreationDate => { },
);

1;
